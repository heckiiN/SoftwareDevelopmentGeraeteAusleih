<Application x:Class="Geraeteausleihe.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Geraeteausleihe.Desktop.ViewModels"
             xmlns:views="clr-namespace:Geraeteausleihe.Desktop.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Farben.xaml" />
                <ResourceDictionary Source="Styles/Steuerelemente.xaml" />
                <ResourceDictionary Source="Styles/Tabelle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="Sichtbar" />

            <!-- Zu jedem ViewModel die passende View -->
            <DataTemplate DataType="{x:Type vm:GeraeteViewModel}">
                <views:GeraeteView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:EntleiherViewModel}">
                <views:EntleiherView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReservierungenViewModel}">
                <views:ReservierungenView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GeraetDialogViewModel}">
                <views:GeraetDialogView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:EntleiherDialogViewModel}">
                <views:EntleiherDialogView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReservierungDialogViewModel}">
                <views:ReservierungDialogView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlatzhalterViewModel}">
                <views:PlatzhalterView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
