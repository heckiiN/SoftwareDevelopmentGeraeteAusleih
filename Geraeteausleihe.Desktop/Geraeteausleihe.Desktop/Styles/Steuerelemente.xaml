<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="Titel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <Style x:Key="Hinweis" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextGedaempft}" />
    </Style>

    <Style x:Key="Hervorgehoben" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Karte" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Flaeche}" />
        <Setter Property="BorderBrush" Value="{StaticResource Rahmen}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="1" />
    </Style>

    <Style x:Key="Symbol" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Menü in der Seitenleiste: der gewählte Punkt ist blau hinterlegt und rechts markiert -->
    <Style x:Key="Navigation" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                    <Setter Property="Margin" Value="0,0,0,4" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Feld" Background="Transparent" CornerRadius="6" Padding="10,8">
                                    <Grid>
                                        <ContentPresenter />
                                        <Border x:Name="Markierung" Width="3" CornerRadius="1.5" Margin="0,0,-4,0"
                                                HorizontalAlignment="Right" Background="{StaticResource Primaer}"
                                                Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Feld" Property="Background" Value="{StaticResource Hover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Feld" Property="Background" Value="{StaticResource PrimaerHell}" />
                                        <Setter TargetName="Markierung" Property="Visibility" Value="Visible" />
                                        <Setter Property="Foreground" Value="{StaticResource PrimaerDunkel}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
