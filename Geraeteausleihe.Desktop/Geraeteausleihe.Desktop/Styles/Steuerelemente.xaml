<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="Titel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <Style x:Key="Hinweis" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextGedaempft}" />
    </Style>

    <Style x:Key="Hervorgehoben" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Karte" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Flaeche}" />
        <Setter Property="BorderBrush" Value="{StaticResource Rahmen}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="1" />
    </Style>

    <Style x:Key="Symbol" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Beschriftung" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="Fehlerhinweis" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FehlerHell}" />
        <Setter Property="BorderBrush" Value="{StaticResource FehlerRahmen}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource FehlerDunkel}" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Height" Value="34" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Rand" Background="{StaticResource Flaeche}" BorderBrush="{StaticResource Rahmen}"
                            BorderThickness="1" CornerRadius="6" Padding="8,0">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Rand" Property="BorderBrush" Value="{StaticResource Primaer}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Schaltflaeche" TargetType="Button">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaerButton" TargetType="Button" BasedOn="{StaticResource Schaltflaeche}">
        <Setter Property="Background" Value="{StaticResource Primaer}" />
        <Setter Property="BorderBrush" Value="{StaticResource Primaer}" />
        <Setter Property="Foreground" Value="White" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaerDunkel}" />
                <Setter Property="BorderBrush" Value="{StaticResource PrimaerDunkel}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SekundaerButton" TargetType="Button" BasedOn="{StaticResource Schaltflaeche}">
        <Setter Property="Background" Value="{StaticResource Flaeche}" />
        <Setter Property="BorderBrush" Value="{StaticResource Rahmen}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Hover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource SekundaerButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Kleiner Button, der nur ein Zeichen aus Segoe MDL2 Assets zeigt -->
    <Style x:Key="SymbolButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextGedaempft}" />
    </Style>

    <!-- Der Platzhaltertext steht in Tag, WPF hat dafür keine eigene Eigenschaft -->
    <Style x:Key="Suchfeld" TargetType="TextBox">
        <Setter Property="Height" Value="34" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Rand" Background="{StaticResource Flaeche}" BorderBrush="{StaticResource Rahmen}"
                            BorderThickness="1" CornerRadius="6" Padding="10,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE721;" Style="{StaticResource Symbol}"
                                       Foreground="{StaticResource TextGedaempft}" Margin="0,0,8,0" />
                            <Grid VerticalAlignment="Center">
                                <TextBlock x:Name="Platzhalter" Text="{TemplateBinding Tag}"
                                           Foreground="{StaticResource TextGedaempft}" Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" />
                            </Grid>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Platzhalter" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Rand" Property="BorderBrush" Value="{StaticResource Primaer}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Kasten" Width="16" Height="16" CornerRadius="3" BorderThickness="1"
                                BorderBrush="{StaticResource Rahmen}" Background="{StaticResource Flaeche}">
                            <TextBlock x:Name="Haken" Text="&#xE73E;" Style="{StaticResource Symbol}" FontSize="10"
                                       Foreground="White" HorizontalAlignment="Center" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Kasten" Property="Background" Value="{StaticResource Primaer}" />
                            <Setter TargetName="Kasten" Property="BorderBrush" Value="{StaticResource Primaer}" />
                            <Setter TargetName="Haken" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menü in der Seitenleiste: der gewählte Punkt ist blau hinterlegt und rechts markiert -->
    <Style x:Key="Navigation" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                    <Setter Property="Margin" Value="0,0,0,4" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Feld" Background="Transparent" CornerRadius="6" Padding="10,8">
                                    <Grid>
                                        <ContentPresenter />
                                        <Border x:Name="Markierung" Width="3" CornerRadius="1.5" Margin="0,0,-4,0"
                                                HorizontalAlignment="Right" Background="{StaticResource Primaer}"
                                                Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Feld" Property="Background" Value="{StaticResource Hover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Feld" Property="Background" Value="{StaticResource PrimaerHell}" />
                                        <Setter TargetName="Markierung" Property="Visibility" Value="Visible" />
                                        <Setter Property="Foreground" Value="{StaticResource PrimaerDunkel}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
