<Window x:Class="Geraeteausleihe.Desktop.Views.DialogFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titel}" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource Text}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding AbbrechenCommand}" />
    </Window.InputBindings>

    <!-- Rand lässt Platz für den Schatten -->
    <Border Margin="20" Background="{StaticResource Flaeche}" CornerRadius="10"
            BorderBrush="{StaticResource Rahmen}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.15" />
        </Border.Effect>
        <StackPanel Width="420">
            <DockPanel Margin="20,16" Background="Transparent" MouseLeftButtonDown="Verschieben">
                <Button DockPanel.Dock="Right" Content="&#xE711;" Command="{Binding AbbrechenCommand}"
                        Style="{StaticResource SymbolButton}" ToolTip="Schließen" />
                <TextBlock Text="{Binding Titel}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <Border BorderBrush="{StaticResource Rahmen}" BorderThickness="0,1,0,0">
                <ContentControl Content="{Binding}" Focusable="False" />
            </Border>
        </StackPanel>
    </Border>
</Window>
