<UserControl x:Class="Geraeteausleihe.Desktop.Views.EntleiherDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FocusManager.FocusedElement="{Binding ElementName=ErstesFeld}">
    <StackPanel>
        <StackPanel Margin="20,16,20,4">
            <TextBlock Text="Name *" Style="{StaticResource Beschriftung}" />
            <TextBox x:Name="ErstesFeld" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

            <TextBlock Text="Kontakt (optional)" Style="{StaticResource Beschriftung}" />
            <TextBox Text="{Binding Kontakt, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

            <Border Style="{StaticResource Fehlerhinweis}" Margin="0,0,0,12"
                    Visibility="{Binding HatFehler, Converter={StaticResource Sichtbar}}">
                <TextBlock Text="{Binding Fehlermeldung}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <Border BorderBrush="{StaticResource Rahmen}" BorderThickness="0,1,0,0" Padding="20,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" Command="{Binding AbbrechenCommand}" Style="{StaticResource TextButton}" />
                <Button Content="{Binding SpeichernText}" Command="{Binding SpeichernCommand}" Style="{StaticResource PrimaerButton}"
                        IsDefault="True" Margin="8,0,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
