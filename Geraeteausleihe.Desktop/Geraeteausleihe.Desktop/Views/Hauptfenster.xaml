<Window x:Class="Geraeteausleihe.Desktop.Views.Hauptfenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Geräteausleihe" Width="1200" Height="760" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource Text}"
        Background="{StaticResource Hintergrund}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Flaeche}"
                BorderBrush="{StaticResource Rahmen}" BorderThickness="0,0,1,0">
            <StackPanel Margin="14,16">
                <StackPanel Orientation="Horizontal">
                    <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource Primaer}">
                        <TextBlock Text="&#xEA18;" Style="{StaticResource Symbol}" Foreground="White"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Verein e.V." FontSize="16" FontWeight="SemiBold" Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="GERÄTEVERWALTUNG" Style="{StaticResource Hinweis}" FontSize="10" Margin="0,6,0,24" />

                <ListBox ItemsSource="{Binding Navigation}" SelectedItem="{Binding AktuellerPunkt}"
                         Style="{StaticResource Navigation}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Symbol}" Style="{StaticResource Symbol}" Width="26" />
                                <TextBlock Text="{Binding Titel}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="System-Status: Bereit" FontSize="11" Margin="0,24,0,0" />
                <TextBlock Text="Lokale Geräteverwaltung" Style="{StaticResource Hinweis}" FontSize="10" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource Flaeche}"
                    BorderBrush="{StaticResource Rahmen}" BorderThickness="0,0,0,1" Padding="24,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource Erfolg}" Margin="0,0,8,0" />
                        <TextBlock Text="Lokaler Arbeitsplatz" FontSize="12" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding AktuellerPunkt.Ueberschrift}" Style="{StaticResource Titel}" />
                        <TextBlock Text="{Binding AktuellerPunkt.Untertitel}" Style="{StaticResource Hinweis}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding AktuellerPunkt.Seite}" Margin="24" Focusable="False" />
        </Grid>
    </Grid>
</Window>
