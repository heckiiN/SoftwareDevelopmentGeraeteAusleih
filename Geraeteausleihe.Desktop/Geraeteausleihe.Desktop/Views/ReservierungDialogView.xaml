<UserControl x:Class="Geraeteausleihe.Desktop.Views.ReservierungDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FocusManager.FocusedElement="{Binding ElementName=ErstesFeld}">
    <StackPanel>
        <StackPanel Margin="20,16,20,4">
            <TextBlock Text="Gerät *" Style="{StaticResource Beschriftung}" />
            <ComboBox x:Name="ErstesFeld" ItemsSource="{Binding Geraete}" SelectedItem="{Binding AusgewaehltesGeraet}"
                      DisplayMemberPath="Bezeichnung" Margin="0,0,0,14" />

            <TextBlock Text="Entleiher *" Style="{StaticResource Beschriftung}" />
            <ComboBox ItemsSource="{Binding Entleiher}" SelectedItem="{Binding AusgewaehlterEntleiher}"
                      DisplayMemberPath="Name" Margin="0,0,0,14" />

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Beginn *" Style="{StaticResource Beschriftung}" />
                    <TextBox Text="{Binding Beginn, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Ende *" Style="{StaticResource Beschriftung}" />
                    <TextBox Text="{Binding Ende, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Erfolgshinweis}" Margin="0,0,0,12"
                    Visibility="{Binding IstVerfuegbar, Converter={StaticResource Sichtbar}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Symbol}" FontSize="11" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Verfuegbarkeitsmeldung}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Fehlerhinweis}" Margin="0,0,0,12"
                    Visibility="{Binding HatFehler, Converter={StaticResource Sichtbar}}">
                <TextBlock Text="{Binding Fehlermeldung}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <Border BorderBrush="{StaticResource Rahmen}" BorderThickness="0,1,0,0" Padding="20,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" Command="{Binding AbbrechenCommand}" Style="{StaticResource TextButton}" />
                <Button Content="Verfügbarkeit prüfen" Command="{Binding VerfuegbarkeitPruefenCommand}"
                        Style="{StaticResource SekundaerButton}" Margin="8,0,0,0" />
                <Button Content="Reservieren" Command="{Binding ReservierenCommand}" Style="{StaticResource PrimaerButton}"
                        IsDefault="True" Margin="8,0,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
