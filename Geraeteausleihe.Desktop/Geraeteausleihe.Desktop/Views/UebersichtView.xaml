<UserControl x:Class="Geraeteausleihe.Desktop.Views.UebersichtView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Command="{Binding NeueReservierungCommand}" Style="{StaticResource PrimaerButton}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Symbol}" FontSize="11" Margin="0,0,8,0" />
                    <TextBlock Text="Neue Reservierung" />
                </StackPanel>
            </Button>
            <TextBlock Text="Ausleihen im Überblick" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <UniformGrid DockPanel.Dock="Top" Rows="1" Margin="-8,0,-8,16">
            <Border Style="{StaticResource Kennzahl}">
                <StackPanel>
                    <TextBlock Text="Laufende Ausleihen" Style="{StaticResource KennzahlTitel}" />
                    <TextBlock Text="{Binding Laufende}" Style="{StaticResource KennzahlWert}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KennzahlWarnung}" Tag="{Binding HatHeuteFaellige}">
                <StackPanel>
                    <TextBlock Text="Heute fällig" Style="{StaticResource KennzahlTitel}" />
                    <TextBlock Text="{Binding HeuteFaellige}" Style="{StaticResource KennzahlWert}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KennzahlFehler}" Tag="{Binding HatUeberfaellige}">
                <StackPanel>
                    <TextBlock Text="Überfällig" Style="{StaticResource KennzahlTitel}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Ueberfaellige}" Style="{StaticResource KennzahlWert}" />
                        <Border Background="{StaticResource FehlerHell}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding HatUeberfaellige, Converter={StaticResource Sichtbar}}">
                            <TextBlock Text="Aktion nötig" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource FehlerDunkel}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Style="{StaticResource Karte}" VerticalAlignment="Top">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Offene Ausleihen" FontSize="14" FontWeight="SemiBold"
                           Margin="14,14,14,6" />
                <TextBlock DockPanel.Dock="Bottom" Text="Zurzeit ist kein Gerät ausgeliehen." Style="{StaticResource Hinweis}"
                           FontSize="12" Margin="14,10,14,14"
                           Visibility="{Binding KeineAusleihen, Converter={StaticResource Sichtbar}}" />
                <DataGrid ItemsSource="{Binding Zeilen}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Gerät" Binding="{Binding Geraet}" Width="*"
                                            ElementStyle="{StaticResource Hervorgehoben}" />
                        <DataGridTextColumn Header="Entleiher" Binding="{Binding Entleiher}" Width="*" />
                        <DataGridTextColumn Header="Rückgabe bis" Width="*"
                                            Binding="{Binding Reservierung.Ende, StringFormat='dd.MM.yyyy, HH:mm'}" />
                        <DataGridTemplateColumn Header="Status" Width="130" CellTemplate="{StaticResource ReservierungsStatusSpalte}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
